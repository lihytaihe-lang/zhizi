.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
__pycache__/

# Distributable installers / 安装包产物
*.dmg
*.exe

# local training workspace (not part of this repository)
ime_context_model/
# local evaluation outputs (not part of this repository)
eval-runs/
