{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Input Method",
  "version": "0.1.5",
  "identifier": "com.agentinputlayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "知字",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "visible": false
      },
      {
        "label": "compact",
        "title": "知字 · 小面板",
        "width": 600,
        "height": 292,
        "minWidth": 520,
        "minHeight": 220,
        "maxWidth": 680,
        "maxHeight": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "../docs/current/licenses/DEPENDENCY_REGISTRY.md",
      "../docs/current/licenses/LOCKED_DEPENDENCIES.json",
      "../docs/current/licenses/NATIVE_LICENSE_ASSETS.json",
      "../native/resources/Skins/Builtin",
      "../native/resources/Skins/skin.schema.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
